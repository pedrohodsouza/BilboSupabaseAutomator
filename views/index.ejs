<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bilbo - Supabase Edge Function Automator</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="container">
    <div class="logo-section">
      <img src="/BilboLogo.png" alt="Bilbo logo" class="logo" />
      <h1>Bilbo</h1>
      <p class="subtitle">Supabase Edge Function Automator</p>
    </div>

    <main>
      <form id="migrateForm">
        <label for="source">Source Project ID</label>
        <input type="text" id="source" name="source" placeholder="ex: abcdefghijklmnop" required />

        <label for="target">Target Project ID</label>
        <input type="text" id="target" name="target" placeholder="ex: qrstuvwxyz123456" required />

        <button type="submit">Start Migration</button>
      </form>

      <div id="logs"></div>
    </main>
  </div>

  <footer>
   <br>
   <img width="20" height="20" src="https://img.icons8.com/color/48/supabase.png" alt="supabase"/>

    <span>For Supabase by <a href="https://github.com/pedrohodsouza" target="_blank" rel="noopener noreferrer">Pedro de Souza</a></span>
    <br>
    <br>
  </footer>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/client.js"></script>
</body>
</html>
